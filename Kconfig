rsource "drivers/Kconfig"

config ZMK_INPUT_ABS2REL_LOG_LEVEL
    int "zmk-input-abs2rel log level (0 off, 1 error, 2 warning, 3 info, 4 debug)"
    range 0 4
    default 3
    help
      Logs contain operational state and numeric diagnostics, never input
      contents, user labels, peer addresses or authentication material.
