 * SPDX-License-Identifier: MIT
 *
 * Two contacts from a touchpad on the peripheral cross the split link as raw
 * absolute coordinates and are converted on the central. The host must see
 * the two-sample-smoothed motion of each contact and nothing between them: no
 * contact button, no delta from the pair the pad sends after a lift, and no
 * jump from where the first contact ended to where the second one lands.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#include "shared.dtsi"

&kscan {
    /delete-property/ exit-after;
    events = <>;
};

&split_listener {
    status = "okay";
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
            &kp A &kp B
            &kp C &kp D>;
        };
    };
};
