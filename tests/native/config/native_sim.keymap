#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/kscan_mock.h>
#include <behaviors/input_processor_absolute_to_relative.dtsi>
/ {
    keymap {
        compatible = "zmk,keymap";
        base { bindings = <&kp A &kp B &kp C &kp D>; };
        extra { bindings = <&trans &trans &trans &trans>; };
    };
    source_a: source_a { compatible = "zmk,input-mock"; event-period = <100>; events = <>; };
    source_b: source_b { compatible = "zmk,input-mock"; event-period = <100>; events = <>; };
    listener_a { compatible = "zmk,input-listener"; device = <&source_a>; input-processors = <&zip_absolute_to_relative>; };
    listener_b { compatible = "zmk,input-listener"; device = <&source_b>; input-processors = <&zip_absolute_to_relative>; };
};
&kscan { events = <ZMK_MOCK_PRESS(0,0,30000)>; };
/* Only this compatibility fixture opts into separate legacy history. */
&zip_absolute_to_relative_scroll { status = "okay"; };
