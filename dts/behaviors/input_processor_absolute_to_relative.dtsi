
/ {
    /* Keep the reference label stable; the short node name is the persisted
     * custom-settings key prefix. */
    zip_absolute_to_relative: abs_rel {
        status = "okay";
        compatible = "zmk,input-processor-absolute-to-relative";
        #input-processor-cells = <0>;
        /* Optional. Both are boolean: present means true, absent means false. */
        /* Consume INPUT_BTN_TOUCH so it does not reach the mouse HID. */
        // suppress-btn-touch;
        /* Consume INPUT_BTN_0 when the trackpad reports a physical click. */
        // suppress-btn0;
    };
};
